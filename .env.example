# ============================================================
# 电商客服聊天后端 - 环境变量示例
# 复制为 .env 并填入真实值：cp .env.example .env
# 默认配置为 DeepSeek，其余四组为备选注释示例（含阿里云百炼）。
# ============================================================

# ---- 必填：LLM API Key ----
LLM_API_KEY=sk-your-deepseek-api-key

# ---- LLM 服务配置（有以下默认值，可按需覆盖）----
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ---- 可选参数（有以下默认值）----
# HISTORY_TOKEN_BUDGET=3000
# REQUEST_TIMEOUT=60

# ---- 必填：嵌入 API Key（SiliconFlow，BGE-M3）----
# SiliconFlow 注册 https://siliconflow.cn 拿 key
EMBEDDING_API_KEY=sk-your-siliconflow-api-key

# ---- 知识库 / 向量检索（有以下默认值）----
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIM=1024
# MILVUS_DB_PATH=data/milvus/baihelp.db
# RETRIEVAL_TOP_K=3
# RETRIEVAL_SCORE_THRESHOLD=0.5
# CHUNK_MAX_CHARS=500
# CHUNK_OVERLAP_CHARS=80
# QA_MINE_BATCH_SIZE=4

# ---- 数据库与工具运行时（有以下默认值，本地无 MySQL 时可换成 SQLite）----
# DATABASE_URL 默认端口 3306；若本机 3306 被占（如本机 MySQL 服务），
# docker-compose 已映射宿主 3307，此时本地 .env 应将端口改为 3307：
# DATABASE_URL=mysql+aiomysql://baihelp:baihelp@127.0.0.1:3306/baihelp?charset=utf8mb4
# TOOL_TIMEOUT_SECONDS=10
# TOOL_MAX_RETRIES=1

# ---- 备选示例 4：阿里云百炼（DashScope OpenAI 兼容模式）----
# LLM_PROVIDER=bailian
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=sk-your-bailian-api-key

# ---- 备选示例 1：OpenAI GPT ----
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-your-openai-api-key

# ---- 备选示例 2：Anthropic Claude（OpenAI 兼容端点）----
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_MODEL=claude-sonnet-4-5
# LLM_API_KEY=sk-ant-your-anthropic-api-key

# ---- 备选示例 3：本地 Ollama ----
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=ollama
